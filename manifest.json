{
  "manifestVersion": 5,
  "id": "com.unn0wn002.mask-integrity.beta",
  "name": "Mask Integrity Doctor - Private Beta",
  "version": "0.3.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.2"
  },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mask-integrity-doctor",
      "label": {
        "default": "Mask Integrity Doctor"
      },
      "minimumSize": {
        "width": 320,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 560,
        "height": 720
      }
    }
  ]
}
